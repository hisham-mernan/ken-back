# Database Configuration
# ======================
# For SQLite (default):
# DATABASE_ENGINE=django.db.backends.sqlite3
# DATABASE_NAME=db.sqlite3

# For PostgreSQL (production):
# DATABASE_ENGINE=django.db.backends.postgresql
# DATABASE_NAME=your_database_name
# DATABASE_USER=your_database_user
# DATABASE_PASSWORD=your_database_password
# DATABASE_HOST=localhost
# DATABASE_PORT=5432


# Supabase Storage (uploads)
# ==========================
# Set all four to store uploads in the Supabase bucket over its S3-compatible
# endpoint. Leave them unset and Django falls back to the local filesystem --
# which on Vercel is /tmp, so uploads there will NOT survive a cold start.
#
# Create these in the Supabase dashboard:
#   Project Settings -> Storage -> S3 Access Keys -> New access key
# The region is shown on that same page.
SUPABASE_S3_ENDPOINT=https://onzkkxvzuzkdcsckcxsp.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
SUPABASE_BUCKET=media

# Public read base for the bucket. Only change this if the project ref changes.
# SUPABASE_PUBLIC_BASE=https://onzkkxvzuzkdcsckcxsp.supabase.co/storage/v1/object/public


# Email Configuration
# ===================
# Gmail SMTP settings
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password

# Alternative: Custom SMTP
# EMAIL_HOST=smtp.yourdomain.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=info@yourdomain.com
# EMAIL_HOST_PASSWORD=your_password


